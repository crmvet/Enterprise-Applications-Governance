{
  "name": "product-ui-harness",
  "version": "0.1.0",
  "private": true,
  "description": "The four pages: a local harness on fictional fixture JSON shaped by the MCP tool output schemas, and the web app on the product REST API. Exact pinned versions only.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "tsc --noEmit -p tsconfig.json && node scripts/check-packages.mjs",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "build:app": "tsc --noEmit -p tsconfig.json && vite build --mode app",
    "dev:app": "vite --mode app",
    "preview": "vite preview --host 127.0.0.1 --port 4318 --strictPort",
    "test": "node scripts/run-tests.mjs",
    "check-packages": "node scripts/check-packages.mjs",
    "screenshots": "node scripts/screenshots.mjs",
    "a11y": "node scripts/a11y.mjs"
  },
  "dependencies": {
    "@azure/msal-browser": "5.29.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.70.0",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwind-merge": "3.7.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "esbuild": "0.28.2",
    "tailwindcss": "4.3.5",
    "tw-animate-css": "1.4.0",
    "typescript": "5.9.3",
    "vite": "7.3.7"
  }
}
