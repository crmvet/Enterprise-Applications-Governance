{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "get_decision_log output",
  "description": "The response envelope. On success, data lists decisions, newest first, with who decided, why and the chain. statement and reason are text people typed.",
  "x-tool": "get_decision_log",
  "x-ai-write-states": [
    "read-only"
  ],
  "type": "object",
  "oneOf": [
    {
      "$ref": "../envelope.schema.json#/$defs/success",
      "properties": {
        "data": {
          "$ref": "#/$defs/data"
        }
      }
    },
    {
      "$ref": "../envelope.schema.json#/$defs/failure"
    }
  ],
  "$defs": {
    "data": {
      "type": "object",
      "required": [
        "items"
      ],
      "properties": {
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "decisionId",
              "decisionType",
              "subjectKind",
              "subjectId",
              "statement",
              "reason",
              "outcome",
              "status",
              "decider",
              "decidedOn",
              "supersedes",
              "supersededBy",
              "amends",
              "approvalsSummary",
              "configurationSetVersion",
              "recordUrl",
              "proposedBy",
              "isAiCreated",
              "performedBy",
              "subjectLabel",
              "exception",
              "ownerChanges"
            ],
            "properties": {
              "decisionId": {
                "$ref": "../common.schema.json#/$defs/id",
                "x-entity": "O09 Decision"
              },
              "decisionType": {
                "$ref": "../common.schema.json#/$defs/labelledKey",
                "description": "The Decision Type (C18)."
              },
              "subjectKind": {
                "$ref": "../common.schema.json#/$defs/decisionSubjectKind"
              },
              "subjectId": {
                "description": "The subject row, or the domain key for a decision about a data domain.",
                "anyOf": [
                  {
                    "$ref": "../common.schema.json#/$defs/id"
                  },
                  {
                    "$ref": "../common.schema.json#/$defs/key"
                  }
                ]
              },
              "statement": {
                "type": "string",
                "description": "One sentence: what was decided.",
                "x-untrusted": true
              },
              "reason": {
                "type": "string",
                "description": "Why.",
                "x-untrusted": true
              },
              "outcome": {
                "description": "The Decision Outcome (C19).",
                "anyOf": [
                  {
                    "$ref": "../common.schema.json#/$defs/labelledKey"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "status": {
                "$ref": "../common.schema.json#/$defs/statusValue",
                "description": "The decision status by meaning."
              },
              "decider": {
                "description": "Who decided. Null while Proposed.",
                "anyOf": [
                  {
                    "$ref": "../common.schema.json#/$defs/principalRef"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "decidedOn": {
                "anyOf": [
                  {
                    "$ref": "../common.schema.json#/$defs/dateTime"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "supersedes": {
                "anyOf": [
                  {
                    "$ref": "../common.schema.json#/$defs/id",
                    "x-entity": "O09 Decision"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "supersededBy": {
                "description": "Derived from the later decision.",
                "anyOf": [
                  {
                    "$ref": "../common.schema.json#/$defs/id",
                    "x-entity": "O09 Decision"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "amends": {
                "anyOf": [
                  {
                    "$ref": "../common.schema.json#/$defs/id",
                    "x-entity": "O09 Decision"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "approvalsSummary": {
                "$ref": "../common.schema.json#/$defs/approvalsSummary"
              },
              "configurationSetVersion": {
                "type": "integer",
                "minimum": 1,
                "description": "The configuration set version the decision was judged by."
              },
              "ownerChanges": {
                "type": "array",
                "description": "For an ownership decision: each proposed owner change, as its owner role key, whether it is a deputy's (an end takes the flag of the assignment it ends) and whether it adds or ends an assignment. Pages match a waiting change to an owner role by these keys, never by the words of the statement. Empty for any other decision.",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "ownerRoleKey",
                    "isDeputy",
                    "change"
                  ],
                  "properties": {
                    "ownerRoleKey": {
                      "$ref": "../common.schema.json#/$defs/key"
                    },
                    "isDeputy": {
                      "type": "boolean"
                    },
                    "change": {
                      "enum": [
                        "add",
                        "end"
                      ]
                    }
                  }
                }
              },
              "proposedBy": {
                "description": "Who proposed the decision, as set once when it was created: the admin who instructed a configuration draft, else the person an AI client drafted it for, else its creator. Never the person whose answer accepted it. Null for a seeded decision.",
                "anyOf": [
                  {
                    "$ref": "../common.schema.json#/$defs/principalRef"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "isAiCreated": {
                "type": "boolean",
                "description": "True when an AI client created the row (the engine's Is AI Created stamp). False for a seeded row."
              },
              "performedBy": {
                "description": "Who made the last engine-checked write of the row, as the engine stamped it (document 24, section 4.5). Null for a row the engine never stamped, such as seeded or imported data.",
                "anyOf": [
                  {
                    "$ref": "../common.schema.json#/$defs/stampedBy"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "recordUrl": {
                "$ref": "../common.schema.json#/$defs/recordUrl"
              },
              "subjectLabel": {
                "type": "string",
                "description": "What the decision is about, as people know it: the application, the request, the change or the deployment.",
                "x-untrusted": true
              },
              "exception": {
                "description": "For an exception decision: the standard it departs from and the date it is reviewed again (B24-9). Null for any other decision.",
                "anyOf": [
                  {
                    "type": "object",
                    "required": [
                      "standard",
                      "reviewOn"
                    ],
                    "properties": {
                      "standard": {
                        "anyOf": [
                          {
                            "type": "string",
                            "x-untrusted": true
                          },
                          {
                            "type": "null"
                          }
                        ]
                      },
                      "reviewOn": {
                        "anyOf": [
                          {
                            "$ref": "../common.schema.json#/$defs/date"
                          },
                          {
                            "type": "null"
                          }
                        ]
                      }
                    },
                    "additionalProperties": false
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "additionalProperties": false
          }
        },
        "skipToken": {
          "$ref": "../common.schema.json#/$defs/nextSkipToken"
        }
      },
      "additionalProperties": false
    }
  },
  "examples": [
    {
      "ok": true,
      "summary": "One accepted decision for this application.",
      "data": {
        "items": [
          {
            "decisionId": "60000000-0000-4000-8000-000000000013",
            "decisionType": {
              "key": "tier",
              "label": "Tier"
            },
            "subjectKind": "business-application",
            "subjectId": "10000000-0000-4000-8000-000000000001",
            "statement": "Field visit planner is tier 2.",
            "reason": "It holds customer addresses.",
            "outcome": {
              "key": "accept",
              "label": "Accept"
            },
            "status": {
              "label": "Accepted",
              "meaning": "accepted"
            },
            "decider": {
              "objectId": "20000000-0000-4000-8000-000000000002",
              "displayLabel": "Owner (sample)"
            },
            "decidedOn": "2026-11-20T14:00:00Z",
            "supersedes": null,
            "supersededBy": null,
            "amends": null,
            "approvalsSummary": {
              "required": 1,
              "approved": 1,
              "rejected": 0,
              "pending": 0
            },
            "configurationSetVersion": 3,
            "proposedBy": {
              "objectId": "20000000-0000-4000-8000-000000000002",
              "displayLabel": "Owner (sample)"
            },
            "isAiCreated": false,
            "performedBy": {
              "actorKind": "engine",
              "principal": {
                "objectId": "20000000-0000-4000-8000-000000000002",
                "displayLabel": "Owner (sample)"
              },
              "onBehalfOf": {
                "objectId": "20000000-0000-4000-8000-000000000002",
                "displayLabel": "Owner (sample)"
              },
              "clientAppLabel": "Approval runner",
              "stampedOn": "2026-11-20T14:00:00Z",
              "draftedBy": null
            },
            "recordUrl": "https://product.example.org/records/60000000-0000-4000-8000-000000000013",
            "subjectLabel": "Field visit planner",
            "exception": null,
            "ownerChanges": []
          }
        ]
      },
      "asOf": "2026-11-22T09:00:00Z",
      "configurationSetVersion": 3,
      "couldNotRead": [],
      "warnings": [],
      "untrustedFields": [
        "items[].statement",
        "items[].reason"
      ],
      "nextSteps": [],
      "correlationId": "corr-0001"
    }
  ]
}
