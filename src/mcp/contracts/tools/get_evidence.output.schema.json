            {
              "type": "null"
            }
          ]
        },
        "title": {
          "type": "string",
          "description": "The change title.",
          "x-untrusted": true
        },
        "changeType": {
          "$ref": "../common.schema.json#/$defs/labelledKey"
        },
        "status": {
          "anyOf": [
            {
              "$ref": "../common.schema.json#/$defs/statusValue"
            },
            {
              "type": "null"
            }
          ]
        },
        "result": {
          "anyOf": [
            {
              "$ref": "../common.schema.json#/$defs/labelledKey"
            },
            {
              "type": "null"
            }
          ]
        },
        "windowStart": {
          "anyOf": [
            {
              "$ref": "../common.schema.json#/$defs/dateTime"
            },
            {
              "type": "null"
            }
          ]
        },
        "windowEnd": {
          "anyOf": [
            {
              "$ref": "../common.schema.json#/$defs/dateTime"
            },
            {
              "type": "null"
            }
          ]
        },
        "authorizationDecisionId": {
          "anyOf": [
            {
              "$ref": "../common.schema.json#/$defs/id",
              "x-entity": "O09 Decision"
            },
            {
              "type": "null"
            }
          ]
        },
        "isAiCreated": {
          "type": "boolean",
          "description": "True when an AI client drafted it."
        },
        "performedBy": {
          "description": "Who made the last engine-checked write, as the engine stamped it. Null for a row the engine never stamped, such as seeded data.",
          "anyOf": [
            {
              "$ref": "../common.schema.json#/$defs/stampedBy"
            },
            {
              "type": "null"
            }
          ]
        },
        "configurationSetVersion": {
          "description": "The configuration set version in force when the row was written, so the rules that applied can be traced. Null for a row with no stamp.",
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "recordUrl": {
          "$ref": "../common.schema.json#/$defs/recordUrl",
          "description": "The record page in the product."
        }
      },
      "additionalProperties": false
    },
    "review": {
      "type": "object",
      "required": [
        "reviewId",
        "recordNumber",
        "reviewType",
