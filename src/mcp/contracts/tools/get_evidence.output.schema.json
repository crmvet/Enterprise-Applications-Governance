    "deployment": {
      "type": "object",
      "description": "One deployment record.",
      "required": [
        "deploymentRecordId",
        "businessApplicationId",
        "applicationName",
        "deploymentTargetId",
        "targetLabel",
        "targetStageKey",
        "artifactName",
        "artifactVersion",
        "result",
        "finishedOn",
        "route",
        "flags",
        "gateLevelApplied",
        "runUrl",
        "correctsRecordId",
        "changeRequestId",
        "pipelineReferenceId",
        "versionBefore",
        "versionAfter",
        "startedByAiClient",
        "isAiCreated",
        "performedBy",
        "configurationSetVersion",
        "recordUrl"
      ],
      "properties": {
        "deploymentRecordId": {
          "$ref": "../common.schema.json#/$defs/id",
