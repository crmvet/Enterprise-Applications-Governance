{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "get_evidence output",
  "description": "The response envelope. On success, data is the evidence pack: the subject, the configuration version in force and the versions stamped on the rows, and the decisions with their approvals, the changes, the deployments, the reviews, the documents and the evidence links. Lists stop at 500 rows each; truncated says so.",
  "x-tool": "get_evidence",
  "x-ai-write-states": [
    "read-only"
  ],
  "type": "object",
  "oneOf": [
    {
      "$ref": "../envelope.schema.json#/$defs/success",
      "properties": {
        "data": {
          "$ref": "#/$defs/data"
        }
      }
    },
    {
      "$ref": "../envelope.schema.json#/$defs/failure"
    }
  ],
  "$defs": {
    "data": {
      "type": "object",
      "required": [
        "subject",
        "configurationInForce",
        "versionsStamped",
        "decisions",
        "changes",
        "deployments",
        "reviews",
        "documents",
        "evidenceLinks",
        "counts",
        "truncated"
      ],
      "properties": {
        "subject": {
          "type": "object",
          "required": [
            "subjectKind",
            "subjectId",
            "label",
            "businessApplicationId",
            "recordUrl"
          ],
          "properties": {
            "subjectKind": {
              "enum": [
                "business-application",
                "decision"
              ]
            },
            "subjectId": {
              "$ref": "../common.schema.json#/$defs/id",
              "x-entity": "O02 Business Application or O09 Decision"
            },
            "label": {
              "type": "string",
              "description": "The application name or the decision statement.",
              "x-untrusted": true
            },
            "businessApplicationId": {
              "anyOf": [
                {
                  "$ref": "../common.schema.json#/$defs/id",
                  "x-entity": "O02 Business Application"
                },
                {
                  "type": "null"
                }
              ]
            },
            "recordUrl": {
              "$ref": "../common.schema.json#/$defs/recordUrl",
              "description": "The record page in the product."
            }
          },
          "additionalProperties": false
        },
        "configurationInForce": {
          "type": "object",
          "description": "The configuration version in force now and its content hash.",
          "required": [
            "configurationSetVersion",
            "contentHash"
          ],
          "properties": {
            "configurationSetVersion": {
              "type": "integer",
              "minimum": 1
            },
            "contentHash": {
              "$ref": "../common.schema.json#/$defs/contentHash"
            }
          },
          "additionalProperties": false
        },
        "versionsStamped": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1
          },
          "description": "Every configuration version the rows in the pack were checked under."
        },
        "decisions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/decision"
          }
        },
        "changes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/change"
          }
        },
        "deployments": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/deployment"
          }
        },
        "reviews": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/review"
          }
        },
        "documents": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/document"
          }
        },
        "evidenceLinks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidenceLink"
          }
        },
        "counts": {
          "type": "object",
          "required": [
            "decisions",
            "approvalAnswers",
            "changes",
            "deployments",
            "flaggedDeployments",
            "reviews",
            "documents",
            "evidenceLinks",
            "aiCreated"
          ],
          "properties": {
            "decisions": {
              "type": "integer",
              "minimum": 0,
              "description": "Decisions in the pack."
            },
            "approvalAnswers": {
              "type": "integer",
              "minimum": 0,
              "description": "Approval requests answered."
            },
            "changes": {
              "type": "integer",
              "minimum": 0,
              "description": "Changes."
            },
            "deployments": {
              "type": "integer",
              "minimum": 0,
              "description": "Deployment records."
            },
            "flaggedDeployments": {
              "type": "integer",
              "minimum": 0,
              "description": "Deployment records with a flag."
            },
            "reviews": {
              "type": "integer",
              "minimum": 0,
              "description": "Reviews."
            },
            "documents": {
              "type": "integer",
              "minimum": 0,
              "description": "Document links."
            },
            "evidenceLinks": {
              "type": "integer",
              "minimum": 0,
              "description": "Evidence links."
            },
            "aiCreated": {
              "type": "integer",
              "minimum": 0,
              "description": "Rows an AI client created among the decisions, changes, deployments and documents."
            }
          },
          "additionalProperties": false
        },
        "truncated": {
          "type": "boolean",
          "description": "True when a list stopped at 500 rows."
        }
      },
      "additionalProperties": false
    },
    "approval": {
      "type": "object",
      "required": [
        "approvalRecordId",
        "askedRole",
        "askedOwnerRole",
        "isConsultation",
        "approver",
        "approverActorKind",
        "outcome",
        "typedReason",
        "requestedOn",
        "respondedOn",
        "countsTowardRequirement",
        "configurationSetVersion"
      ],
      "properties": {
        "approvalRecordId": {
          "$ref": "../common.schema.json#/$defs/id",
          "x-entity": "O10 Approval Record"
        },
        "askedRole": {
          "anyOf": [
            {
              "$ref": "../common.schema.json#/$defs/labelledKey"
            },
            {
              "type": "null"
            }
          ]
        },
        "askedOwnerRole": {
          "anyOf": [
            {
              "$ref": "../common.schema.json#/$defs/labelledKey"
            },
            {
              "type": "null"
            }
          ]
        },
        "isConsultation": {
          "type": "boolean",
          "description": "True for a consultation, which never counts."
        },
        "approver": {
          "anyOf": [
            {
              "$ref": "../common.schema.json#/$defs/principalRef"
            },
            {
              "type": "null"
            }
          ]
        },
        "approverActorKind": {
          "anyOf": [
            {
              "type": "string",
              "description": "The actor kind of the answer. An AI actor's answer is a recommendation only."
            },
            {
              "type": "null"
            }
          ]
        },
        "outcome": {
          "$ref": "../common.schema.json#/$defs/statusValue"
        },
        "typedReason": {
          "anyOf": [
            {
              "type": "string",
              "description": "The reason the approver typed.",
              "x-untrusted": true
            },
            {
              "type": "null"
            }
          ]
        },
        "requestedOn": {
          "anyOf": [
            {
              "$ref": "../common.schema.json#/$defs/dateTime"
            },
            {
              "type": "null"
            }
          ]
        },
        "respondedOn": {
          "anyOf": [
            {
              "$ref": "../common.schema.json#/$defs/dateTime"
            },
            {
              "type": "null"
            }
          ]
        },
        "countsTowardRequirement": {
          "type": "boolean",
          "description": "True when the engine counted the answer."
        },
        "configurationSetVersion": {
          "description": "The configuration set version in force when the row was written, so the rules that applied can be traced. Null for a row with no stamp.",
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "decision": {
      "type": "object",
      "required": [
        "decisionId",
        "recordNumber",
        "decisionType",
        "statement",
        "reason",
        "outcome",
        "status",
        "proposedBy",
        "decider",
        "decidedOn",
        "settledBy",
        "approvals",
        "isAiCreated",
        "performedBy",
        "configurationSetVersion",
        "recordUrl"
      ],
      "properties": {
        "decisionId": {
          "$ref": "../common.schema.json#/$defs/id",
          "x-entity": "O09 Decision"
        },
        "recordNumber": {
          "anyOf": [
            {
              "type": "string",
              "description": "The decision number, such as DEC-0146."
            },
            {
              "type": "null"
            }
          ]
        },
        "decisionType": {
          "$ref": "../common.schema.json#/$defs/labelledKey"
        },
        "statement": {
          "type": "string",
          "description": "What was decided.",
          "x-untrusted": true
        },
        "reason": {
          "anyOf": [
            {
              "type": "string",
              "description": "Why.",
              "x-untrusted": true
            },
            {
              "type": "null"
            }
          ]
        },
        "outcome": {
          "anyOf": [
            {
              "$ref": "../common.schema.json#/$defs/labelledKey"
            },
            {
              "type": "null"
            }
          ]
        },
        "status": {
          "$ref": "../common.schema.json#/$defs/statusValue"
        },
        "proposedBy": {
          "anyOf": [
            {
              "$ref": "../common.schema.json#/$defs/principalRef"
            },
            {
              "type": "null"
            }
          ]
        },
        "decider": {
          "anyOf": [
            {
              "$ref": "../common.schema.json#/$defs/principalRef"
            },
            {
              "type": "null"
            }
          ]
        },
        "decidedOn": {
          "anyOf": [
            {
              "$ref": "../common.schema.json#/$defs/dateTime"
            },
            {
              "type": "null"
            }
          ]
        },
        "settledBy": {
          "description": "How a settled decision was settled. Null while proposed.",
          "anyOf": [
            {
              "enum": [
                "answers",
                "engine",
                "person",
                "recorded"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "approvals": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/approval"
          }
        },
        "isAiCreated": {
          "type": "boolean",
          "description": "True when an AI client drafted it."
        },
        "performedBy": {
          "description": "Who made the last engine-checked write, as the engine stamped it. Null for a row the engine never stamped, such as seeded data.",
          "anyOf": [
            {
              "$ref": "../common.schema.json#/$defs/stampedBy"
            },
            {
              "type": "null"
            }
          ]
        },
        "configurationSetVersion": {
          "description": "The configuration set version in force when the row was written, so the rules that applied can be traced. Null for a row with no stamp.",
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "recordUrl": {
          "$ref": "../common.schema.json#/$defs/recordUrl",
          "description": "The record page in the product."
        }
      },
      "additionalProperties": false
    },
    "change": {
      "type": "object",
      "required": [
        "changeRequestId",
        "recordNumber",
        "title",
        "changeType",
        "status",
        "result",
        "windowStart",
        "windowEnd",
        "authorizationDecisionId",
        "isAiCreated",
        "performedBy",
        "configurationSetVersion",
        "recordUrl"
      ],
      "properties": {
        "changeRequestId": {
          "$ref": "../common.schema.json#/$defs/id",
          "x-entity": "O11 Change Request"
        },
        "recordNumber": {
          "anyOf": [
