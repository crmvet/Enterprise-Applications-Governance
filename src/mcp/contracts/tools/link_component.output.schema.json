{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "link_component output",
  "description": "The response envelope. On success, data is the write result for the Technical Component (O03), a link. A retired outcome is stored as reported.",
  "x-tool": "link_component",
  "x-ai-write-states": [
    "link",
    "as-reported"
  ],
  "type": "object",
  "oneOf": [
    {
      "$ref": "../envelope.schema.json#/$defs/success",
      "properties": {
        "data": {
          "$ref": "#/$defs/data"
        }
      }
    },
    {
      "$ref": "../envelope.schema.json#/$defs/failure"
    }
  ],
  "$defs": {
    "data": {
      "$ref": "../envelope.schema.json#/$defs/writeResult",
      "description": "The write result for the Technical Component (O03).",
      "properties": {
        "status": {
          "type": "null",
          "description": "A Technical Component has no status."
        },
        "technicalComponentId": {
          "description": "Null only when validateOnly was true and the call would create a new row.",
          "anyOf": [
            {
              "$ref": "../common.schema.json#/$defs/id",
              "x-entity": "O03 Technical Component"
            },
            {
              "type": "null"
            }
          ]
        },
        "outcome": {
          "enum": [
            "linked",
            "moved",
            "retired"
          ]
        },
        "retiredOn": {
          "$ref": "../common.schema.json#/$defs/date",
          "description": "For retired: the date the engine set."
        },
        "claimStatus": {
          "$ref": "../common.schema.json#/$defs/statusValue",
          "description": "For a resolved vanished claim: its new status, claimed by meaning.",
          "properties": {
            "meaning": {
              "$ref": "../common.schema.json#/$defs/claimStatusMeaning"
            }
          }
        }
      },
      "required": [
        "technicalComponentId",
        "outcome"
      ],
      "unevaluatedProperties": false
    }
  },
  "examples": [
    {
      "ok": true,
      "summary": "The flow Visit reminder is now linked to Field visit planner.",
      "data": {
        "recordId": "80000000-0000-4000-8000-000000000001",
        "status": null,
        "performedBy": {
          "actorKind": "ai-client-for-person",
          "principal": {
            "objectId": "20000000-0000-4000-8000-000000000001",
            "displayLabel": "Requester (sample)"
          },
          "onBehalfOf": {
            "objectId": "20000000-0000-4000-8000-000000000001",
            "displayLabel": "Requester (sample)"
          },
          "clientApp": {
            "appId": "40000000-0000-4000-8000-000000000001",
            "label": "Claude Code"
          }
        },
        "isAiCreated": true,
        "engineStamp": {
          "engineVersion": "0.1.0",
          "engineCheckedOn": "2026-11-22T09:00:00Z"
        },
        "created": true,
        "technicalComponentId": "80000000-0000-4000-8000-000000000001",
        "outcome": "linked"
      },
      "links": {
        "recordUrl": "https://product.example.org/records/10000000-0000-4000-8000-000000000001"
      },
      "asOf": "2026-11-22T09:00:00Z",
      "configurationSetVersion": 3,
      "couldNotRead": [],
      "warnings": [],
      "untrustedFields": [],
      "nextSteps": [],
      "correlationId": "corr-0001"
    }
  ]
}
