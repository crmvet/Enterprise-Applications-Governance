{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "claim_resource output",
  "description": "The response envelope. On success, data is the write result for the Claim (O23), now claimed, with the component link, the application and, when needed, the Proposed ownership decision. A claim for a new application starts an intake request; a claim by someone who holds no owner role on an existing application submits an ownership decision for its owners to confirm.",
  "x-tool": "claim_resource",
  "x-ai-write-states": [
    "link",
    "draft",
    "proposed"
  ],
  "type": "object",
  "oneOf": [
    {
      "$ref": "../envelope.schema.json#/$defs/success",
      "properties": {
        "data": {
          "$ref": "#/$defs/data"
        }
      }
    },
    {
      "$ref": "../envelope.schema.json#/$defs/failure"
    }
  ],
  "$defs": {
    "data": {
      "$ref": "../envelope.schema.json#/$defs/writeResult",
      "description": "The write result for the Claim (O23).",
      "properties": {
        "status": {
          "$ref": "../common.schema.json#/$defs/statusValue",
          "description": "Always claimed.",
          "properties": {
            "meaning": {
              "$ref": "../common.schema.json#/$defs/claimStatusMeaning",
              "const": "claimed"
            }
          }
        },
        "technicalComponentId": {
          "description": "The component link written. Null only when validateOnly was true.",
          "anyOf": [
            {
              "$ref": "../common.schema.json#/$defs/id",
              "x-entity": "O03 Technical Component"
            },
            {
              "type": "null"
            }
          ]
        },
        "businessApplicationId": {
          "description": "Null only when validateOnly was true and a new application was asked for.",
          "anyOf": [
            {
              "$ref": "../common.schema.json#/$defs/id",
              "x-entity": "O02 Business Application"
            },
            {
              "type": "null"
            }
          ]
        },
        "applicationCreated": {
          "type": "boolean",
          "description": "True when a new application was started as Draft."
        },
        "applicationStatus": {
          "description": "Null only when validateOnly was true and a new application was asked for.",
          "anyOf": [
            {
              "$ref": "../common.schema.json#/$defs/statusValue",
              "description": "The application's registration status. Draft for a new application.",
              "properties": {
                "meaning": {
                  "$ref": "../common.schema.json#/$defs/registrationStatusMeaning",
                  "enum": [
                    "draft",
                    "registered",
                    "archived"
                  ]
                }
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "ownershipDecisionId": {
          "description": "The ownership decision about the claim, when the caller holds no owner role on the existing application: submitted at once for a person, proposed for the person to submit when an AI client claimed it. Null otherwise.",
          "anyOf": [
            {
              "$ref": "../common.schema.json#/$defs/id",
              "x-entity": "O09 Decision"
            },
            {
              "type": "null"
            }
          ]
        },
        "approvalsNeeded": {
          "type": "array",
          "items": {
            "$ref": "../common.schema.json#/$defs/approvalNeeded"
          },
          "description": "The approvals the ownership decision needs."
        },
        "intakeRequestId": {
          "description": "The draft intake request a claim for a new application starts (P01), naming the draft application that holds the component. Null otherwise, and when validateOnly was true.",
          "anyOf": [
            {
              "$ref": "../common.schema.json#/$defs/id",
              "x-entity": "O07 Intake Request"
            },
            {
              "type": "null"
            }
          ]
        },
        "decisionSubmitted": {
          "type": "boolean",
          "description": "True when the ownership decision was submitted in this call, so approval requests were opened."
        },
        "approvalsRequested": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "approvalRecordId",
              "approvalMode",
              "expiresOn",
              "channelKey",
              "isConsultation"
            ],
            "properties": {
              "approvalRecordId": {
                "$ref": "../common.schema.json#/$defs/id",
                "x-entity": "O10 Approval Record"
              },
              "requiredRoleKey": {
                "$ref": "../common.schema.json#/$defs/key",
                "x-entity": "C29 Role",
                "description": "The role whose holder must answer."
              },
              "requiredOwnerRoleKey": {
                "$ref": "../common.schema.json#/$defs/key",
                "x-entity": "C28 Owner Role",
                "description": "The owner role whose holder must answer."
              },
              "askedPrincipal": {
                "description": "The one person asked by name (O10 Asked Principal): a proposed owner, or the nearest portfolio's accountable person when no holder of the owner role is left. Null when the holders of the role or owner role are asked.",
                "anyOf": [
                  {
                    "$ref": "../common.schema.json#/$defs/principalRef"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "approvalMode": {
                "$ref": "../common.schema.json#/$defs/approvalMode"
              },
              "expiresOn": {
                "description": "When the request expires.",
                "anyOf": [
                  {
                    "$ref": "../common.schema.json#/$defs/dateTime"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "channelKey": {
                "$ref": "../common.schema.json#/$defs/key",
                "x-entity": "C07 List Value",
                "description": "Where the notice of the request goes, from the channel value list."
              },
              "isConsultation": {
                "type": "boolean",
                "description": "True for a consulted role (Is Consultation on C32). Its answer is a recommendation and never counts."
              }
            },
            "additionalProperties": false,
            "description": "One approval request the engine created, with outcome pending. Only a person answers it, on the decision page.",
            "oneOf": [
              {
                "required": [
                  "requiredRoleKey"
                ]
              },
              {
                "required": [
                  "requiredOwnerRoleKey"
                ]
              }
            ]
          },
          "description": "The approval requests the engine opened for the ownership decision. Empty when none was submitted, or when validateOnly was true."
        },
        "engineAccepted": {
          "description": "Set only for the locked list. Null otherwise.",
          "anyOf": [
            {
              "type": "object",
              "required": [
                "decisionId",
                "condition"
              ],
              "properties": {
                "decisionId": {
                  "$ref": "../common.schema.json#/$defs/id",
                  "x-entity": "O09 Decision"
                },
                "condition": {
                  "enum": [
                    "lowest-tier",
                    "standard-model"
                  ],
                  "description": "The engine acceptance condition from the locked setting engine-acceptable-decision-types."
                }
              },
              "additionalProperties": false,
              "description": "The engine accepted the decision without an approval request, as an engine effect stamped with actor kind engine.",
              "$comment": "WORKING DEFAULT (open design question 8). The engine accepts without an approval request only for a locked list: lowest-tier intake and standard changes whose model a person approved once."
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "technicalComponentId",
        "businessApplicationId",
        "applicationCreated",
        "applicationStatus",
        "ownershipDecisionId",
        "approvalsNeeded",
        "intakeRequestId",
        "decisionSubmitted",
        "approvalsRequested",
        "engineAccepted"
      ],
      "unevaluatedProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "applicationCreated": {
                "const": true
              }
            },
            "required": [
              "applicationCreated"
            ]
          },
          "then": {
            "properties": {
              "applicationStatus": {
                "anyOf": [
                  {
                    "properties": {
                      "meaning": {
                        "const": "draft"
                      }
                    }
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            }
          }
        }
      ]
    }
  },
  "examples": [
    {
      "ok": true,
      "summary": "The item is claimed. A new draft application holds it.",
      "data": {
        "recordId": "c0000000-0000-4000-8000-000000000002",
        "status": {
          "label": "Claimed",
          "meaning": "claimed"
        },
        "performedBy": {
          "actorKind": "ai-client-for-person",
          "principal": {
            "objectId": "20000000-0000-4000-8000-000000000001",
            "displayLabel": "Requester (sample)"
          },
          "onBehalfOf": {
            "objectId": "20000000-0000-4000-8000-000000000001",
            "displayLabel": "Requester (sample)"
          },
          "clientApp": {
            "appId": "40000000-0000-4000-8000-000000000001",
            "label": "Claude Code"
          }
        },
        "isAiCreated": true,
        "engineStamp": {
          "engineVersion": "0.1.0",
          "engineCheckedOn": "2026-11-22T09:00:00Z"
        },
        "created": false,
        "technicalComponentId": "80000000-0000-4000-8000-000000000003",
        "businessApplicationId": "10000000-0000-4000-8000-000000000004",
        "applicationCreated": true,
        "applicationStatus": {
          "label": "Draft",
          "meaning": "draft"
        },
        "ownershipDecisionId": null,
        "approvalsNeeded": [],
        "intakeRequestId": null,
        "decisionSubmitted": false,
        "approvalsRequested": [],
        "engineAccepted": null
      },
      "links": {
        "recordUrl": "https://product.example.org/records/10000000-0000-4000-8000-000000000004"
      },
      "asOf": "2026-11-22T09:00:00Z",
      "configurationSetVersion": 3,
      "couldNotRead": [],
      "warnings": [],
      "untrustedFields": [],
      "nextSteps": [],
      "correlationId": "corr-0001"
    }
  ]
}
