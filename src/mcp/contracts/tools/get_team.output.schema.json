{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "get_team output",
  "description": "The response envelope. On success, data is one team: its members, roles, the decision types it answers, its applications and data owner roles, what waits on it now, its latest answers and the owner gaps among its applications.",
  "x-tool": "get_team",
  "x-ai-write-states": [
    "read-only"
  ],
  "type": "object",
  "oneOf": [
    {
      "$ref": "../envelope.schema.json#/$defs/success",
      "properties": {
        "data": {
          "$ref": "#/$defs/data"
        }
      }
    },
    {
      "$ref": "../envelope.schema.json#/$defs/failure"
    }
  ],
  "$defs": {
    "data": {
      "type": "object",
      "required": [
        "team",
        "kinds",
        "directoryState",
        "isKnownToProduct",
        "members",
        "membersReadFrom",
        "membership",
        "roles",
        "decisionTypes",
        "applications",
        "dataAssignments",
        "ownerGaps",
        "waiting",
        "waitingOnMembers",
        "membersOwn",
        "recentAnswers",
        "counts"
      ],
      "properties": {
        "team": {
          "$ref": "../common.schema.json#/$defs/directoryObject"
        },
        "kinds": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/teamKind"
          },
          "description": "Derived when read, never stored: committee (bound to a role that answers decisions), support-team (holds a current support owner or technical owner assignment), role-group (any other bound group), other (none of these)."
        },
        "directoryState": {
          "anyOf": [
            {
              "$ref": "../common.schema.json#/$defs/directoryState"
            },
            {
              "type": "null"
            }
          ],
          "description": "The group's state as the owner check last read it, or null for a group the product holds no reference to."
        },
        "isKnownToProduct": {
          "type": "boolean",
          "description": "True when the product holds a Principal Reference for the group; false for a group known only from a role binding."
        },
        "members": {
          "anyOf": [
            {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "objectId",
                  "displayLabel",
                  "principalKind"
                ],
                "properties": {
                  "objectId": {
                    "$ref": "../common.schema.json#/$defs/guid"
                  },
                  "displayLabel": {
                    "type": "string"
                  },
                  "principalKind": {
                    "$ref": "../common.schema.json#/$defs/principalKind"
                  }
                },
                "additionalProperties": false
              }
            },
            {
              "type": "null"
            }
          ],
          "description": "The group's members as the directory gives them, by name. Null when they are not read: the directory reads are off, or the directory did not answer."
        },
        "membersReadFrom": {
          "enum": [
            "entra-live",
            "demo-personas",
            "not-read"
          ],
          "description": "Where the members come from: Entra, read live as the signed-in person and never stored; the demo personas; or nowhere, when membership is managed in Entra and not read here."
        },
        "membership": {
          "type": "string",
          "description": "Where membership comes from, in one sentence, naming the group when it is managed in Entra."
        },
        "roles": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "role",
              "party",
              "duties",
              "answersDecisions",
              "binding",
              "decisionRights",
              "approvals"
            ],
            "properties": {
              "role": {
                "$ref": "../common.schema.json#/$defs/labelledKey"
              },
              "party": {
                "anyOf": [
                  {
                    "$ref": "../common.schema.json#/$defs/labelledKey"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "duties": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "answersDecisions": {
                "type": "boolean",
                "description": "True when an approval rule asks the role to approve or consults it, or a decision right gives it the responsible, accountable or consulted letter: what makes the group a committee."
              },
              "binding": {
                "type": "object",
                "required": [
                  "bindingKey",
                  "bindingMethod",
                  "lastVerifiedOn"
                ],
                "properties": {
                  "bindingKey": {
                    "$ref": "../common.schema.json#/$defs/keyPath"
                  },
                  "bindingMethod": {
                    "anyOf": [
                      {
                        "enum": [
                          "dataverse-group-team",
                          "entra-app-role-assignment"
                        ]
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "lastVerifiedOn": {
                    "anyOf": [
                      {
                        "$ref": "../common.schema.json#/$defs/dateTime"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  }
                },
                "additionalProperties": false
              },
              "decisionRights": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "decisionRight",
                    "decisionType",
                    "letter",
                    "scope"
                  ],
                  "properties": {
                    "decisionRight": {
                      "$ref": "../common.schema.json#/$defs/labelledKey"
                    },
                    "decisionType": {
                      "$ref": "../common.schema.json#/$defs/labelledKey"
                    },
                    "letter": {
                      "type": "string"
                    },
                    "scope": {
                      "type": "string",
                      "description": "The scope in words, such as \"Tier 3, Production\", or \"All\"."
                    }
                  },
                  "additionalProperties": false
                }
              },
              "approvals": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "approvalRule",
                    "decisionType",
                    "isConsultation",
                    "scope",
                    "guidelineRef"
                  ],
                  "properties": {
                    "approvalRule": {
                      "$ref": "../common.schema.json#/$defs/labelledKey"
                    },
                    "decisionType": {
                      "$ref": "../common.schema.json#/$defs/labelledKey"
                    },
                    "isConsultation": {
                      "type": "boolean"
                    },
                    "scope": {
                      "type": "string"
                    },
                    "guidelineRef": {
                      "anyOf": [
                        {
                          "$ref": "../common.schema.json#/$defs/guidelineRef"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    }
                  },
                  "additionalProperties": false
                }
              }
            },
            "additionalProperties": false
          },
          "description": "The product roles bound to the group in the configuration in force (C30), with the decision rights (C31) and approval rules (C32) that name each."
        },
        "decisionTypes": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "decisionType",
              "letters",
              "approves",
              "consulted",
              "roleKeys"
            ],
            "properties": {
              "decisionType": {
                "$ref": "../common.schema.json#/$defs/labelledKey"
              },
              "letters": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "The decision right letters its roles hold on the type, such as responsible, accountable or consulted."
              },
              "approves": {
                "type": "boolean",
                "description": "An approval rule asks one of its roles to approve decisions of the type."
              },
              "consulted": {
                "type": "boolean",
                "description": "An approval rule consults one of its roles on decisions of the type."
              },
              "roleKeys": {
                "type": "array",
                "items": {
                  "$ref": "../common.schema.json#/$defs/key"
                }
              },
              "throughOwnerRole": {
                "$ref": "../common.schema.json#/$defs/labelledKey",
                "description": "Set when the team's people answer the type as the named holder of this owner role on their own data domains or locations (a data owner answers the data-use and retention decisions of the domains they own), not through the team's product role."
              }
            },
            "additionalProperties": false
          },
          "description": "The decision types the team answers, from the decision rights and approval rules of its roles, by label."
        },
        "applications": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "businessApplicationId",
              "name",
              "recordNumber",
              "tier",
              "stage",
              "registration",
              "assignments",
              "ownerGapCount",
              "recordUrl"
            ],
            "properties": {
              "businessApplicationId": {
                "$ref": "../common.schema.json#/$defs/id"
              },
              "name": {
                "type": "string"
              },
              "recordNumber": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "tier": {
                "anyOf": [
                  {
                    "$ref": "../common.schema.json#/$defs/labelledKey"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "stage": {
                "anyOf": [
                  {
                    "$ref": "../common.schema.json#/$defs/labelledKey"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "registration": {
                "anyOf": [
                  {
                    "$ref": "../common.schema.json#/$defs/registrationStatusMeaning"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "assignments": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "ownerAssignmentId",
                    "ownerRole",
                    "isDeputy",
                    "startOn"
                  ],
                  "properties": {
                    "ownerAssignmentId": {
                      "$ref": "../common.schema.json#/$defs/id"
                    },
                    "ownerRole": {
                      "$ref": "../common.schema.json#/$defs/labelledKey"
                    },
                    "isDeputy": {
                      "type": "boolean"
                    },
                    "startOn": {
                      "anyOf": [
                        {
                          "$ref": "../common.schema.json#/$defs/date"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    }
                  },
                  "additionalProperties": false
                }
              },
              "ownerGapCount": {
                "type": "integer",
                "minimum": 0
              },
              "recordUrl": {
                "$ref": "../common.schema.json#/$defs/recordUrl"
              }
            },
            "additionalProperties": false
          },
          "description": "The applications, not archived, the team holds a current owner role on, by name, with its assignments there."
        },
        "dataAssignments": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "ownerAssignmentId",
              "ownerRole",
              "isDeputy",
              "startOn",
              "subjectKind",
              "subjectId",
              "label",
              "recordUrl"
            ],
            "properties": {
              "ownerAssignmentId": {
                "$ref": "../common.schema.json#/$defs/id"
              },
              "ownerRole": {
                "$ref": "../common.schema.json#/$defs/labelledKey"
              },
              "isDeputy": {
                "type": "boolean"
              },
              "startOn": {
                "anyOf": [
                  {
                    "$ref": "../common.schema.json#/$defs/date"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "subjectKind": {
                "enum": [
                  "data-domain",
                  "data-location"
                ]
              },
              "subjectId": {
                "type": "string",
                "description": "The data domain key, or the data location ID."
              },
              "label": {
                "type": "string",
                "description": "The domain's path, or the location's name."
              },
              "recordUrl": {
                "$ref": "../common.schema.json#/$defs/recordUrl"
              }
            },
            "additionalProperties": false
          },
          "description": "The data domains and data locations the team holds a current owner role on."
        },
        "ownerGaps": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "businessApplicationId",
              "applicationName",
              "ownerRole",
              "missing",
              "holderDirectoryState",
              "recordUrl"
            ],
            "properties": {
              "businessApplicationId": {
                "$ref": "../common.schema.json#/$defs/id"
              },
              "applicationName": {
                "type": "string"
              },
              "ownerRole": {
                "$ref": "../common.schema.json#/$defs/labelledKey"
              },
              "missing": {
                "enum": [
                  "holder",
                  "deputy"
                ]
              },
              "holderDirectoryState": {
                "anyOf": [
                  {
                    "$ref": "../common.schema.json#/$defs/directoryState"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "recordUrl": {
                "$ref": "../common.schema.json#/$defs/recordUrl"
              }
            },
            "additionalProperties": false
          },
          "description": "The owner gaps on its registered applications, counted as the Overview and the Owners page count them: no holder, no deputy, or a holder whose account is off."
        },
        "waiting": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ask"
          },
          "description": "Pending approval requests waiting on the team now: the request names the team, asks a role it holds, or asks an owner role it holds on the decision's application. Soonest expiry first."
        },
        "waitingOnMembers": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "member",
              "request"
            ],
            "properties": {
              "member": {
                "$ref": "../common.schema.json#/$defs/principalRef",
                "description": "The member the request asks: by name, or as the holder of the owner role it asks on the decision's application or data domain."
              },
              "request": {
                "$ref": "#/$defs/ask"
              }
            },
            "additionalProperties": false
          },
          "description": "Pending approval requests asked of one of its members, not of the team: a request that names the member, or asks an owner role the member holds on the decision's application or data domain. Empty when the members are not read. Soonest expiry first."
        },
        "membersOwn": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "member",
              "ownerRole",
              "isDeputy",
              "subjectKind",
              "subjectId",
              "label",
              "recordUrl"
            ],
            "properties": {
              "member": {
                "$ref": "../common.schema.json#/$defs/principalRef"
              },
              "ownerRole": {
                "$ref": "../common.schema.json#/$defs/labelledKey"
              },
              "isDeputy": {
                "type": "boolean"
              },
              "subjectKind": {
                "enum": [
                  "business-application",
                  "data-domain",
                  "data-location"
                ]
              },
              "subjectId": {
                "type": "string",
                "description": "The application's ID, the data domain key, or the data location ID."
              },
              "label": {
                "type": "string",
                "description": "The application's name, the domain's path, or the location's name."
              },
              "recordUrl": {
                "$ref": "../common.schema.json#/$defs/recordUrl"
              }
            },
            "additionalProperties": false
          },
          "description": "What its members own in their own name: their current owner roles on applications and on data, by member, then by what they own (up to 200). Empty when the members are not read."
        },
        "recentAnswers": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ask"
          },
          "description": "The latest answers (up to 20) people gave through the team: requests it was asked, answered approved or rejected by a person, and by one of its members when the members are read. Newest first."
        },
        "counts": {
          "type": "object",
          "required": [
            "members",
            "roles",
            "decisionTypes",
            "applications",
            "assignments",
            "waiting",
            "waitingOnMembers",
            "membersOwn",
            "answered",
            "ownerGaps"
          ],
          "properties": {
            "members": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0,
              "description": "People in the group; null when the members are not read."
            },
            "roles": {
              "type": "integer",
              "minimum": 0
            },
            "decisionTypes": {
              "type": "integer",
              "minimum": 0
            },
            "applications": {
              "type": "integer",
              "minimum": 0
            },
            "assignments": {
              "type": "integer",
              "minimum": 0
            },
            "waiting": {
              "type": "integer",
              "minimum": 0
            },
            "answered": {
              "type": "integer",
              "minimum": 0,
              "description": "Every answer given through the team, not only the latest 20."
            },
            "waitingOnMembers": {
              "type": "integer",
              "minimum": 0
            },
            "membersOwn": {
              "type": "integer",
              "minimum": 0,
              "description": "Every owner role its members hold, not only the 200 listed."
            },
            "ownerGaps": {
              "type": "integer",
              "minimum": 0
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "teamKind": {
      "enum": [
        "committee",
        "support-team",
        "role-group",
        "other"
      ]
    },
    "ask": {
      "type": "object",
      "required": [
        "approvalRecordId",
        "decision",
        "subject",
        "askedRole",
        "askedOwnerRole",
        "isConsultation",
        "outcome",
        "approver",
        "requestedOn",
        "respondedOn",
        "expiresOn",
        "isExpired",
        "recordUrl"
      ],
      "properties": {
        "approvalRecordId": {
          "$ref": "../common.schema.json#/$defs/id"
        },
        "decision": {
          "type": "object",
          "required": [
            "decisionId",
            "recordNumber",
            "decisionType",
            "statement",
            "status"
          ],
          "properties": {
            "decisionId": {
              "$ref": "../common.schema.json#/$defs/id"
            },
            "recordNumber": {
              "type": [
                "string",
                "null"
              ],
              "description": "DEC- and a number, or null for a decision with no number."
            },
            "decisionType": {
              "$ref": "../common.schema.json#/$defs/labelledKey"
            },
            "statement": {
              "type": "string"
            },
            "status": {
              "$ref": "../common.schema.json#/$defs/statusValue"
            }
          },
          "additionalProperties": false
        },
        "subject": {
          "type": "object",
          "required": [
            "subjectKind",
            "label",
            "businessApplicationId",
            "applicationName"
          ],
          "properties": {
            "subjectKind": {
              "$ref": "../common.schema.json#/$defs/decisionSubjectKind"
            },
            "label": {
              "type": "string"
            },
            "businessApplicationId": {
              "anyOf": [
                {
                  "$ref": "../common.schema.json#/$defs/id"
                },
                {
                  "type": "null"
                }
              ]
            },
            "applicationName": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "additionalProperties": false
        },
        "askedRole": {
          "anyOf": [
            {
              "$ref": "../common.schema.json#/$defs/labelledKey"
            },
            {
              "type": "null"
            }
          ],
          "description": "The product role the request asks, or null."
        },
        "askedOwnerRole": {
          "anyOf": [
            {
              "$ref": "../common.schema.json#/$defs/labelledKey"
            },
            {
              "type": "null"
            }
          ],
          "description": "The owner role the request asks on the decision's application, or null."
        },
        "isConsultation": {
          "type": "boolean"
        },
        "outcome": {
          "$ref": "../common.schema.json#/$defs/statusValue",
          "description": "Pending while it waits; approved or rejected once answered."
        },
        "approver": {
          "anyOf": [
            {
              "$ref": "../common.schema.json#/$defs/principalRef"
            },
            {
              "type": "null"
            }
          ],
          "description": "The person who answered, or null while it waits."
        },
        "requestedOn": {
          "anyOf": [
            {
              "$ref": "../common.schema.json#/$defs/dateTime"
            },
            {
              "type": "null"
            }
          ]
        },
        "respondedOn": {
          "anyOf": [
            {
              "$ref": "../common.schema.json#/$defs/dateTime"
            },
            {
              "type": "null"
            }
          ]
        },
        "expiresOn": {
          "anyOf": [
            {
              "$ref": "../common.schema.json#/$defs/dateTime"
            },
            {
              "type": "null"
            }
          ]
        },
        "isExpired": {
          "type": "boolean",
          "description": "True for a pending request past its expiry date (the daily refresh expires it and asks again)."
        },
        "recordUrl": {
          "$ref": "../common.schema.json#/$defs/recordUrl",
          "description": "The decision page, where a person answers it."
        }
      },
      "additionalProperties": false,
      "description": "One approval request on a team page, with its decision's number and link."
    }
  }
}
