        },
        "approvalsNeeded": {
          "type": "array",
          "items": {
            "$ref": "../common.schema.json#/$defs/approvalNeeded"
          }
        }
      },
      "required": [
        "decisionId",
        "pendingAssignments",
        "approvalsNeeded"
      ],
      "unevaluatedProperties": false
    }
  },
