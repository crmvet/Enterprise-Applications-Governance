{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "find_data_domains output",
  "description": "The response envelope. On success, data lists the matching domains in tree order, with their owners, rules, counts and gaps.",
  "x-tool": "find_data_domains",
  "x-ai-write-states": [
    "read-only"
  ],
  "type": "object",
  "oneOf": [
    {
      "$ref": "../envelope.schema.json#/$defs/success",
      "properties": {
        "data": {
          "$ref": "#/$defs/data"
        }
      }
    },
    {
      "$ref": "../envelope.schema.json#/$defs/failure"
    }
  ],
  "$defs": {
    "data": {
      "type": "object",
      "required": [
        "items",
        "totalCount"
      ],
      "properties": {
        "items": {
          "type": "array",
          "items": {
            "$ref": "../common.schema.json#/$defs/dataDomainItem"
          }
        },
        "totalCount": {
          "type": "integer",
          "minimum": 0,
          "description": "How many domains match."
        },
        "skipToken": {
          "$ref": "../common.schema.json#/$defs/nextSkipToken"
        }
      },
      "additionalProperties": false
    }
  }
}
