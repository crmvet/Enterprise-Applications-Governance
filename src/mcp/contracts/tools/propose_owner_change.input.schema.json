{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "propose_owner_change input",
  "description": "Hand over or add an owner of an application, a data domain or a data location. Records a proposed ownership decision (O09) about the one subject named; the owner assignments (O06) start only when the decision is accepted. A data domain's owners are proposed by the platform admin, the data governance lead or a data owner of the domain or a domain above it; a location's by the platform admin, the data governance lead or its technical owner (docs/architecture/data-taxonomy.md, Appointing owners). The owner role must be one that can be held on the subject (C28 Subject Kinds).",
  "x-tool": "propose_owner_change",
  "type": "object",
  "required": [
    "changes",
    "reason"
  ],
  "properties": {
    "businessApplicationId": {
      "$ref": "../common.schema.json#/$defs/id",
      "x-entity": "O02 Business Application",
      "description": "The application. Give exactly one of businessApplicationId, dataDomainKey and dataLocationId."
    },
    "changes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "object",
        "required": [
          "ownerRoleKey"
        ],
        "properties": {
          "ownerRoleKey": {
            "$ref": "../common.schema.json#/$defs/key",
            "x-entity": "C28 Owner Role",
            "description": "The owner role."
          },
          "addObjectId": {
            "$ref": "../common.schema.json#/$defs/guid",
            "description": "The Entra object ID of the new holder."
          },
          "endAssignmentId": {
            "$ref": "../common.schema.json#/$defs/id",
            "x-entity": "O06 Owner Assignment",
            "description": "The assignment to end."
          },
          "isDeputy": {
            "type": "boolean",
            "default": false,
            "description": "True for a deputy."
          },
          "startOn": {
            "$ref": "../common.schema.json#/$defs/date",
            "description": "When the new assignment starts, once accepted."
          }
        },
        "additionalProperties": false,
        "anyOf": [
          {
            "required": [
              "addObjectId"
            ]
          },
          {
            "required": [
              "endAssignmentId"
            ]
          }
        ]
      },
      "description": "The owner changes to propose."
    },
    "reason": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000,
      "description": "Why the change is needed."
    },
    "clientRequestId": {
      "$ref": "../common.schema.json#/$defs/clientRequestId"
    },
    "validateOnly": {
      "$ref": "../common.schema.json#/$defs/validateOnly"
    },
    "dataDomainKey": {
      "$ref": "../common.schema.json#/$defs/key",
      "x-entity": "C49 Data Domain",
      "description": "The data domain whose owners change (data taxonomy slice 3)."
    },
    "dataLocationId": {
      "$ref": "../common.schema.json#/$defs/id",
      "x-entity": "O25 Data Location",
      "description": "The data location whose technical owner changes (data taxonomy slice 3)."
    }
  },
  "additionalProperties": false,
  "examples": [
    {
      "businessApplicationId": "10000000-0000-4000-8000-000000000001",
      "changes": [
        {
          "ownerRoleKey": "business-owner",
          "addObjectId": "20000000-0000-4000-8000-000000000003",
          "endAssignmentId": "50000000-0000-4000-8000-000000000001",
          "startOn": "2026-12-01"
        }
      ],
      "reason": "The current owner moves to another team in December.",
      "clientRequestId": "req-0005"
    }
  ],
  "oneOf": [
    {
      "required": [
        "businessApplicationId"
      ]
    },
    {
      "required": [
        "dataDomainKey"
      ]
    },
    {
      "required": [
        "dataLocationId"
      ]
    }
  ]
}
