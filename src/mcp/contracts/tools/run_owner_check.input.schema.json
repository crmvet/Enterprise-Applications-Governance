{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "run_owner_check input",
  "description": "The on-demand owner check. It runs live as the signed-in admin: the server reads, from Microsoft Graph, the account state and leave date of every principal with an active owner assignment. Disabled, deleted or leaving owners become findings, and the engine opens an owner check review for each affected application. No unattended job. Long runs come back in pages.",
  "x-tool": "run_owner_check",
  "type": "object",
  "properties": {
    "gapCheckRunId": {
      "$ref": "../common.schema.json#/$defs/id",
      "x-entity": "O22 Gap Check Run",
      "description": "Continue this run."
    },
    "businessApplicationIds": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "uniqueItems": true,
      "items": {
        "$ref": "../common.schema.json#/$defs/id",
        "x-entity": "O02 Business Application"
      },
      "description": "Only owners of these applications."
    },
    "principalObjectIds": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "uniqueItems": true,
      "items": {
        "$ref": "../common.schema.json#/$defs/guid"
      },
      "description": "Only these principals."
    },
    "skipToken": {
      "$ref": "../common.schema.json#/$defs/skipToken"
    },
    "clientRequestId": {
      "$ref": "../common.schema.json#/$defs/clientRequestId"
    },
    "validateOnly": {
      "$ref": "../common.schema.json#/$defs/validateOnly"
    }
  },
  "additionalProperties": false,
  "dependentRequired": {
    "skipToken": [
      "gapCheckRunId"
    ]
  },
  "examples": [
    {
      "businessApplicationIds": [
        "10000000-0000-4000-8000-000000000001"
      ],
      "clientRequestId": "req-0503"
    }
  ]
}
