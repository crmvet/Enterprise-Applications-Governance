{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "record_deployment output",
  "description": "The response envelope. On success, data is the write result for the Deployment Record (O14), with the route, the flags and the gate level the engine applied. created is false when a retry matched the idempotency key. Through MCP the route meaning is always ai-tool.",
  "$comment": "WORKING DEFAULT (open design question 7). Reported code approvals are evidence only. AI-only code approvals never count as authorization, and the shipped gate default flags them. WORKING DEFAULT (open design question 12). Pipelines do not use MCP. They call the record endpoint with this contract, as a workload identity that holds the deployment recorder role through a Workload Grant (C42).",
  "x-tool": "record_deployment",
  "x-ai-write-states": [
    "as-reported"
  ],
  "type": "object",
  "oneOf": [
    {
      "$ref": "../envelope.schema.json#/$defs/success",
      "properties": {
        "data": {
          "$ref": "#/$defs/data"
        }
      }
    },
    {
      "$ref": "../envelope.schema.json#/$defs/failure"
    }
  ],
  "$defs": {
    "data": {
      "$ref": "#/$defs/recordResult",
      "properties": {
        "route": {
          "properties": {
            "meaning": {
              "const": "ai-tool"
            }
          }
        }
      }
    },
    "recordResult": {
      "$ref": "../envelope.schema.json#/$defs/writeResult",
      "description": "The write result for the Deployment Record (O14). Upserted by idempotencyKey.",
      "properties": {
        "status": {
          "$ref": "../common.schema.json#/$defs/statusValue",
          "description": "The deployment result, as reported.",
          "properties": {
            "meaning": {
              "$ref": "../common.schema.json#/$defs/deploymentResultMeaning"
            }
          }
        },
        "deploymentRecordId": {
          "description": "Null only when validateOnly was true and the key is new.",
          "anyOf": [
            {
              "$ref": "../common.schema.json#/$defs/id",
              "x-entity": "O14 Deployment Record"
            },
            {
              "type": "null"
            }
          ]
        },
        "artifactVersionId": {
          "description": "Upserted by artifact name plus version. Null only when validateOnly was true and the version is new.",
          "anyOf": [
            {
              "$ref": "../common.schema.json#/$defs/id",
              "x-entity": "O13 Artifact Version"
            },
            {
              "type": "null"
            }
          ]
        },
        "deploymentTargetId": {
          "description": "The target the engine resolved. Null when the external ID matched no target yet.",
          "anyOf": [
            {
              "$ref": "../common.schema.json#/$defs/id",
              "x-entity": "O15 Deployment Target"
            },
            {
              "type": "null"
            }
          ]
        },
        "changeRequestId": {
          "description": "The change the engine linked, given or matched. Null when none matched, or several did.",
          "anyOf": [
            {
              "$ref": "../common.schema.json#/$defs/id",
              "x-entity": "O11 Change Request"
            },
            {
              "type": "null"
            }
          ]
        },
        "route": {
          "$ref": "../common.schema.json#/$defs/deploymentRoute",
          "description": "Set by the engine from the entry point, never by the caller."
        },
        "flags": {
          "$ref": "../common.schema.json#/$defs/deploymentFlags",
          "description": "Computed by the engine. The caller cannot set them."
        },
        "gateLevelApplied": {
          "$ref": "../common.schema.json#/$defs/gateLevel",
          "description": "The gate level the engine applied, from the Gate Policy row for the tier, change type and target stage."
        }
      },
      "required": [
        "deploymentRecordId",
        "artifactVersionId",
        "deploymentTargetId",
        "changeRequestId",
        "route",
        "flags",
        "gateLevelApplied"
      ],
      "unevaluatedProperties": false
    }
  },
  "examples": [
    {
      "ok": true,
      "summary": "The deployment is recorded. It is not flagged.",
      "data": {
        "recordId": "d2000000-0000-4000-8000-000000000001",
        "status": {
          "label": "Succeeded",
          "meaning": "succeeded"
        },
        "performedBy": {
          "actorKind": "ai-client-for-person",
          "principal": {
            "objectId": "20000000-0000-4000-8000-000000000001",
            "displayLabel": "Requester (sample)"
          },
          "onBehalfOf": {
            "objectId": "20000000-0000-4000-8000-000000000001",
            "displayLabel": "Requester (sample)"
          },
          "clientApp": {
            "appId": "40000000-0000-4000-8000-000000000001",
            "label": "Claude Code"
          }
        },
        "isAiCreated": true,
        "engineStamp": {
          "engineVersion": "0.1.0",
          "engineCheckedOn": "2026-11-22T09:00:00Z"
        },
        "created": true,
        "deploymentRecordId": "d2000000-0000-4000-8000-000000000001",
        "artifactVersionId": "d3000000-0000-4000-8000-000000000001",
        "deploymentTargetId": "d4000000-0000-4000-8000-000000000002",
        "changeRequestId": "d0000000-0000-4000-8000-000000000002",
        "route": {
          "key": "ai-tool",
          "meaning": "ai-tool"
        },
        "flags": {
          "outsideWindow": false,
          "otherPath": false,
          "missingApproval": false,
          "aiOnlyCodeApproval": false
        },
        "gateLevelApplied": "advise"
      },
      "links": {
        "recordUrl": "https://product.example.org/records/d2000000-0000-4000-8000-000000000001"
      },
      "asOf": "2026-11-22T09:00:00Z",
      "configurationSetVersion": 3,
      "couldNotRead": [],
      "warnings": [],
      "untrustedFields": [],
      "nextSteps": [],
      "correlationId": "corr-0001"
    }
  ]
}
