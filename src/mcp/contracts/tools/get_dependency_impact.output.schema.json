{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "get_dependency_impact output",
  "description": "The response envelope. On success, data lists every application reached, with its depth and path.",
  "x-tool": "get_dependency_impact",
  "x-ai-write-states": [
    "read-only"
  ],
  "type": "object",
  "oneOf": [
    {
      "$ref": "../envelope.schema.json#/$defs/success",
      "properties": {
        "data": {
          "$ref": "#/$defs/data"
        }
      }
    },
    {
      "$ref": "../envelope.schema.json#/$defs/failure"
    }
  ],
  "$defs": {
    "data": {
      "type": "object",
      "required": [
        "root",
        "nodes",
        "dataLocation",
        "counts",
        "truncatedAtDepth"
      ],
      "properties": {
        "root": {
          "type": "object",
          "required": [
            "businessApplicationId",
            "technicalComponentId",
            "dataLocationId",
            "kind",
            "name"
          ],
          "properties": {
            "businessApplicationId": {
              "anyOf": [
                {
                  "$ref": "../common.schema.json#/$defs/id",
                  "x-entity": "O02 Business Application"
                },
                {
                  "type": "null"
                }
              ]
            },
            "technicalComponentId": {
              "anyOf": [
                {
                  "$ref": "../common.schema.json#/$defs/id",
                  "x-entity": "O03 Technical Component"
                },
                {
                  "type": "null"
                }
              ]
            },
            "dataLocationId": {
              "anyOf": [
                {
                  "$ref": "../common.schema.json#/$defs/id",
                  "x-entity": "O25 Data Location"
                },
                {
                  "type": "null"
                }
              ]
            },
            "kind": {
              "enum": [
                "application",
                "component",
                "data-location"
              ],
              "description": "What the walk starts at."
            },
            "name": {
              "type": "string",
              "description": "The start of the walk.",
              "x-untrusted": true
            }
          },
          "additionalProperties": false
        },
        "nodes": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "businessApplicationId",
              "name",
              "tier",
              "lifecycleMeaning",
              "businessOwner",
              "technicalOwner",
              "dependencyTypeKey",
              "via",
              "criticalityKey",
              "depth",
              "path"
            ],
            "properties": {
              "businessApplicationId": {
                "$ref": "../common.schema.json#/$defs/id",
                "x-entity": "O02 Business Application"
              },
              "name": {
                "type": "string",
                "description": "The application name.",
                "x-untrusted": true
              },
              "tier": {
                "anyOf": [
                  {
                    "$ref": "../common.schema.json#/$defs/labelledKey"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "lifecycleMeaning": {
                "anyOf": [
                  {
                    "$ref": "../common.schema.json#/$defs/lifecycleMeaning"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "businessOwner": {
                "anyOf": [
                  {
                    "$ref": "../common.schema.json#/$defs/principalRef"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "technicalOwner": {
                "anyOf": [
                  {
                    "$ref": "../common.schema.json#/$defs/principalRef"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "dependencyTypeKey": {
                "description": "The counted dependency type on the last hop. Null for a node that joined the walk through a data use, a component it is built from or uses as its AI component, or the location it is (see via).",
                "anyOf": [
                  {
                    "$ref": "../common.schema.json#/$defs/key",
                    "x-entity": "C17 Dependency Type"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "via": {
                "enum": [
                  "dependency",
                  "part-of",
                  "ai-component",
                  "data-use",
                  "hosts-location"
                ],
                "description": "How the node joined the walk: a dependency (O04), or, in the first ring of a component or data location start, the application built from the component, one using it as its AI component, one with an open data use at the location, or the application the location is."
              },
              "criticalityKey": {
                "description": "From the criticality value list.",
                "anyOf": [
                  {
                    "$ref": "../common.schema.json#/$defs/key",
                    "x-entity": "C07 List Value"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "depth": {
                "type": "integer",
                "minimum": 1,
                "description": "Hops from the root."
              },
              "path": {
                "type": "array",
                "items": {
                  "$ref": "../common.schema.json#/$defs/id"
                },
                "description": "The IDs from the root (an application, a component or a data location) to this node."
              }
            },
            "additionalProperties": false
          }
        },
        "dataLocation": {
          "description": "For a data location start: what the location holds. Null otherwise.",
          "anyOf": [
            {
              "type": "object",
              "required": [
                "label",
                "platform",
                "hostedBy",
                "childLocationIds",
                "domainsHeld",
                "dataUseCount"
              ],
              "properties": {
                "label": {
                  "type": "string",
                  "x-untrusted": true
                },
                "platform": {
                  "anyOf": [
                    {
                      "$ref": "../common.schema.json#/$defs/labelledKey"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "hostedBy": {
                  "anyOf": [
                    {
                      "type": "object",
                      "required": [
                        "businessApplicationId",
                        "name"
                      ],
                      "properties": {
                        "businessApplicationId": {
                          "$ref": "../common.schema.json#/$defs/id"
                        },
                        "name": {
                          "type": "string",
                          "x-untrusted": true
                        }
                      },
                      "additionalProperties": false
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "childLocationIds": {
                  "type": "array",
                  "items": {
                    "$ref": "../common.schema.json#/$defs/id"
                  }
                },
                "domainsHeld": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": [
                      "key",
                      "path",
                      "origins"
                    ],
                    "properties": {
                      "key": {
                        "$ref": "../common.schema.json#/$defs/key"
                      },
                      "path": {
                        "type": "string"
                      },
                      "origins": {
                        "type": "array",
                        "items": {
                          "$ref": "../common.schema.json#/$defs/dataOrigin"
                        }
                      }
                    },
                    "additionalProperties": false
                  }
                },
                "dataUseCount": {
                  "type": "integer",
                  "minimum": 0
                }
              },
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        },
        "counts": {
          "type": "object",
          "required": [
            "byTier",
            "byCriticality"
          ],
          "properties": {
            "byTier": {
              "type": "array",
              "items": {
                "$ref": "../common.schema.json#/$defs/bucket"
              }
            },
            "byCriticality": {
              "type": "array",
              "items": {
                "$ref": "../common.schema.json#/$defs/bucket"
              }
            }
          },
          "additionalProperties": false
        },
        "truncatedAtDepth": {
          "type": "boolean",
          "description": "True when the walk stopped at the depth limit with more to walk."
        }
      },
      "additionalProperties": false
    }
  },
  "examples": [
    {
      "ok": true,
      "summary": "Two applications depend on Field visit planner. One is tier 3.",
      "data": {
        "root": {
          "businessApplicationId": "10000000-0000-4000-8000-000000000001",
          "technicalComponentId": null,
          "dataLocationId": null,
          "kind": "application",
          "name": "Field visit planner"
        },
        "nodes": [
          {
            "businessApplicationId": "10000000-0000-4000-8000-000000000002",
            "name": "Route optimizer",
            "tier": {
              "key": "tier-3",
              "label": "Tier 3"
            },
            "lifecycleMeaning": "live",
            "businessOwner": {
              "objectId": "20000000-0000-4000-8000-000000000002",
              "displayLabel": "Business owner (sample)"
            },
            "technicalOwner": null,
            "dependencyTypeKey": "reads-data-from",
            "via": "dependency",
            "criticalityKey": "high",
            "depth": 1,
            "path": [
              "10000000-0000-4000-8000-000000000001",
              "10000000-0000-4000-8000-000000000002"
            ]
          },
          {
            "businessApplicationId": "10000000-0000-4000-8000-000000000003",
            "name": "Visit report",
            "tier": {
              "key": "tier-1",
              "label": "Tier 1"
            },
            "lifecycleMeaning": "live",
            "businessOwner": null,
            "technicalOwner": null,
            "dependencyTypeKey": "calls-api-of",
            "via": "dependency",
            "criticalityKey": null,
            "depth": 2,
            "path": [
              "10000000-0000-4000-8000-000000000001",
              "10000000-0000-4000-8000-000000000002",
              "10000000-0000-4000-8000-000000000003"
            ]
          }
        ],
        "dataLocation": null,
        "counts": {
          "byTier": [
            {
              "key": "tier-3",
              "label": "Tier 3",
              "count": 1
            },
            {
              "key": "tier-1",
              "label": "Tier 1",
              "count": 1
            }
          ],
          "byCriticality": [
            {
              "key": "high",
              "label": "High",
              "count": 1
            },
            {
              "key": null,
              "label": "Not set",
              "count": 1
            }
          ]
        },
        "truncatedAtDepth": false
      },
      "asOf": "2026-11-22T09:00:00Z",
      "configurationSetVersion": 3,
      "couldNotRead": [],
      "warnings": [],
      "untrustedFields": [
        "root.name",
        "nodes[].name"
      ],
      "nextSteps": [],
      "correlationId": "corr-0001"
    }
  ]
}
