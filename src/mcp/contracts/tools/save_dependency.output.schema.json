          },
          "onBehalfOf": null,
          "clientApp": {
            "appId": "40000000-0000-4000-8000-000000000009",
            "label": "Web app"
          }
        },
        "isAiCreated": false,
        "engineStamp": {
          "engineVersion": "0.1.0",
          "engineCheckedOn": "2026-11-24T09:00:00Z"
        },
        "created": true,
        "dependencyId": "b0000000-0000-4000-8000-000000000001",
        "fromApplication": {
          "businessApplicationId": "10000000-0000-4000-8000-000000000001",
          "name": "Field Inspections"
        },
        "to": {
          "businessApplicationId": "10000000-0000-4000-8000-000000000002",
          "technicalComponentId": null,
          "name": "Asset Register"
        },
        "dependencyType": {
          "key": "reads-data-from",
          "label": "Reads data from"
        },
        "criticality": {
          "key": "high",
          "label": "High"
        },
        "endedOn": null
      },
      "links": {},
