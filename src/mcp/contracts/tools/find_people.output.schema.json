{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "find_people output",
  "description": "The response envelope. On success, data lists the people whose name matches, names that start with the text first.",
  "x-tool": "find_people",
  "x-ai-write-states": [
    "read-only"
  ],
  "type": "object",
  "oneOf": [
    {
      "$ref": "../envelope.schema.json#/$defs/success",
      "properties": {
        "data": {
          "$ref": "#/$defs/data"
        }
      }
    },
    {
      "$ref": "../envelope.schema.json#/$defs/failure"
    }
  ],
  "$defs": {
    "data": {
      "type": "object",
      "required": [
        "items",
        "totalCount"
      ],
      "properties": {
        "items": {
          "type": "array",
          "maxItems": 50,
          "items": {
            "type": "object",
            "required": [
              "objectId",
              "displayLabel",
              "principalKind",
              "directoryState"
            ],
            "properties": {
              "objectId": {
                "$ref": "../common.schema.json#/$defs/guid"
              },
              "displayLabel": {
                "type": "string",
                "minLength": 1,
                "description": "The name as the directory gives it.",
                "x-untrusted": true
              },
              "principalKind": {
                "$ref": "../common.schema.json#/$defs/principalKind"
              },
              "directoryState": {
                "description": "The account state the last owner check found, or null when none was checked.",
                "anyOf": [
                  {
                    "$ref": "../common.schema.json#/$defs/directoryState"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "additionalProperties": false
          }
        },
        "totalCount": {
          "type": "integer",
          "minimum": 0,
          "description": "How many people match in all."
        }
      },
      "additionalProperties": false
    }
  },
  "examples": [
    {
      "ok": true,
      "summary": "1 person(s) match \"pri\".",
      "data": {
        "items": [
          {
            "objectId": "20000000-0000-4000-8000-000000000001",
            "displayLabel": "Requester (sample)",
            "principalKind": "user",
            "directoryState": "enabled"
          }
        ],
        "totalCount": 1
      },
      "links": {},
      "asOf": "2026-11-24T09:00:00Z",
      "configurationSetVersion": 3,
      "couldNotRead": [],
      "warnings": [],
      "untrustedFields": [],
      "nextSteps": [],
      "correlationId": "corr-0061"
    }
  ]
}
