{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "list_claims input",
  "description": "The claim list for owners. Rows follow the claim-visibility setting, which defaults to admins and claimant. Writes nothing.",
  "x-tool": "list_claims",
  "type": "object",
  "properties": {
    "statusMeanings": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "uniqueItems": true,
      "items": {
        "$ref": "../common.schema.json#/$defs/claimStatusMeaning"
      },
      "description": "Only claims with these status meanings.",
      "default": [
        "open"
      ]
    },
    "suggestedToMe": {
      "type": "boolean",
      "description": "True returns only claims suggested to the caller."
    },
    "findingKinds": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2,
      "uniqueItems": true,
      "items": {
        "$ref": "../common.schema.json#/$defs/findingKind"
      },
      "description": "Only these finding kinds."
    },
    "componentKindKeys": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "uniqueItems": true,
      "items": {
        "$ref": "../common.schema.json#/$defs/key",
        "x-entity": "C16 Component Kind"
      },
      "description": "Only these component kinds."
    },
    "top": {
      "$ref": "../common.schema.json#/$defs/top"
    },
    "skipToken": {
      "$ref": "../common.schema.json#/$defs/skipToken"
    }
  },
  "additionalProperties": false,
  "examples": [
    {
      "suggestedToMe": true
    }
  ]
}
