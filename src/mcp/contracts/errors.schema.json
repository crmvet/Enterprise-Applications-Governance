{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MCP error code catalog",
  "description": "Schema for errors.json, the fixed error codes of the response envelope.",
  "type": "object",
  "required": [
    "description",
    "retryableMeans",
    "engineReasonsMeans",
    "codes"
  ],
  "properties": {
    "description": {
      "type": "string",
      "minLength": 1
    },
    "retryableMeans": {
      "type": "string",
      "minLength": 1
    },
    "engineReasonsMeans": {
      "type": "string",
      "minLength": 1
    },
    "codes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "code",
          "meaning",
          "retryable",
          "httpStatus",
          "clientAction"
        ],
        "properties": {
          "code": {
            "type": "string",
            "pattern": "^[a-z]+(_[a-z]+)*$",
            "description": "The fixed code, lowercase snake_case."
          },
          "meaning": {
            "type": "string",
            "minLength": 1
          },
          "retryable": {
            "type": "boolean"
          },
          "httpStatus": {
            "type": "integer",
            "minimum": 400,
            "maximum": 599,
            "description": "The HTTP status the record endpoint and the Azure binding return. On Dataverse, rule refusals arrive as 400 (document 25, section 7)."
          },
          "clientAction": {
            "type": "string",
            "minLength": 1,
            "description": "What an AI client should do next."
          },
          "engineReasons": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]*(\\.([a-z0-9-]+|\\*))+$"
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
