{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Record endpoint: deployment response",
  "description": "The response body of the record endpoint: the record_deployment response envelope. performedBy carries actor kind pipeline and the route meaning is pipeline-step. A failure carries one of the fixed error codes; the HTTP status follows errors.json.",
  "$comment": "WORKING DEFAULT (open design question 12). Pipelines do not use MCP. They call the record endpoint with this contract, as a workload identity that holds the deployment recorder role through a Workload Grant (C42).",
  "type": "object",
  "oneOf": [
    {
      "$ref": "../envelope.schema.json#/$defs/success",
      "properties": {
        "data": {
          "$ref": "#/$defs/data"
        }
      }
    },
    {
      "$ref": "../envelope.schema.json#/$defs/failure"
    }
  ],
  "$defs": {
    "data": {
      "$ref": "../tools/record_deployment.output.schema.json#/$defs/recordResult",
      "properties": {
        "route": {
          "properties": {
            "meaning": {
              "const": "pipeline-step"
            }
          }
        },
        "performedBy": {
          "properties": {
            "actorKind": {
              "const": "pipeline"
            }
          }
        },
        "isAiCreated": {
          "const": false
        }
      }
    }
  },
  "examples": [
    {
      "ok": true,
      "summary": "The deployment is recorded. It arrived outside its window and is flagged.",
      "data": {
        "recordId": "d2000000-0000-4000-8000-000000000003",
        "status": {
          "label": "Succeeded",
          "meaning": "succeeded"
        },
        "performedBy": {
          "actorKind": "pipeline",
          "principal": {
            "objectId": "e1000000-0000-4000-8000-000000000001",
            "displayLabel": "Release pipeline identity",
            "principalKind": "service-principal"
          },
          "onBehalfOf": null,
          "clientApp": null
        },
        "isAiCreated": false,
        "engineStamp": {
          "engineVersion": "0.1.0",
          "engineCheckedOn": "2026-11-22T09:00:00Z"
        },
        "created": true,
        "deploymentRecordId": "d2000000-0000-4000-8000-000000000003",
        "artifactVersionId": "d3000000-0000-4000-8000-000000000002",
        "deploymentTargetId": "d4000000-0000-4000-8000-000000000002",
        "changeRequestId": "d0000000-0000-4000-8000-000000000002",
        "route": {
          "key": "pipeline-step",
          "meaning": "pipeline-step"
        },
        "flags": {
          "outsideWindow": true,
          "otherPath": false,
          "missingApproval": false,
          "aiOnlyCodeApproval": false
        },
        "gateLevelApplied": "advise"
      },
      "links": {
        "recordUrl": "https://product.example.org/records/d2000000-0000-4000-8000-000000000003"
      },
      "asOf": "2026-11-22T09:00:00Z",
      "configurationSetVersion": 3,
      "couldNotRead": [],
      "warnings": [],
      "untrustedFields": [],
      "nextSteps": [],
      "correlationId": "corr-0001"
    },
    {
      "ok": false,
      "summary": "No gate policy row matches. The configuration is broken; the step warns and the deployment goes on.",
      "error": {
        "code": "configuration_unavailable",
        "message": "No gate policy row matches tier 2, normal change, production."
      },
      "asOf": "2026-11-22T09:00:00Z",
      "configurationSetVersion": 3,
      "correlationId": "corr-0002"
    }
  ]
}
